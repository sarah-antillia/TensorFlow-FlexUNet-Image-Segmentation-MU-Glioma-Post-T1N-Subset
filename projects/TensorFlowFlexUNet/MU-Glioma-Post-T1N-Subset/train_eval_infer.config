; train_eval_infer.config
; 2026/04/25 (C) antillia.com
; MU-Glioma-Post-T1N-Subset segmentation
[model]
model         = "TensorFlowFlexUNet"
generator     =  False

image_width    = 256
image_height   = 256
image_channels = 3
input_normalize = True
normalization  = False
num_classes    = 5
base_filters   = 16
base_kernels   = (11,11)
num_layers     = 8
dropout_rate   = 0.05
dilation       = (1,1)

; Model compilation parameters
optimizer       = "Adam"

learning_rate  = 0.00007
clipvalue      = 0.5

; Specify "categorical_crossentropy" function to loss
; for categoraized(one-hot-encoded) mask 
loss           = "categorical_crossentropy"
metrics        = ["dice_coef_multiclass"]

show_summary   = False

[dataset]
class_name    = "ImageCategorizedMaskDataset"

[train]
;epochs       = 50
epochs        = 100
batch_size    = 2

;steps_per_epoch  = 200
;validation_steps = 80

; EarlyStopping parameter
patience      = 10

metrics       = ["dice_coef_multiclass", "val_dice_coef_multiclass"]

model_dir     = "./models/"
eval_dir      = "./eval/"
images_dir    = "../../../dataset/MU-Glioma-Post-T1N-Subset/train/images/"
masks_dir     = "../../../dataset/MU-Glioma-Post-T1N-Subset/train/masks/"

create_backup  = False

; learning_rate_reducer callback parameter
learning_rate_reducer = True
reducer_factor     = 0.5
reducer_patience   = 5

; Model saving option
save_weights_only  = True

[valid]
images_dir = "../../../dataset/MU-Glioma-Post-T1N-Subset/valid/images/"
masks_dir  = "../../../dataset/MU-Glioma-Post-T1N-Subset/valid/masks/"

[test] 
images_dir = "../../../dataset/MU-Glioma-Post-T1N-Subset/test/images/"
masks_dir  = "../../../dataset/MU-Glioma-Post-T1N-Subset/test/masks/"

[infer] 
images_dir    = "./mini_test/images/"
output_dir    = "./mini_test_output/"

[infer3d] 
;Specify an images_dir of NIfTI files
images_dir    = "./mini_test_3d/images/"

output_dir    = "./mini_test_3d_output/"

slice_shape_order = "hwd"
slice_resize   = (384,384)
slice_rotation = cv2.ROTATE_90_CLOCKWISE 

mask_overlay  = True


[image]
color_order = "RGB"

[mask]
mask_datatyoe    = "categorized"
mask_file_format = ".png"
;MU-Glioma-Post-T1N-Subset rgb color map dict for 1+4 classes.

rgb_map = {(0,0,0):0, (255,0,0):1, (0,255,0):2, (0,0,255):3, (255,255,0):4}


